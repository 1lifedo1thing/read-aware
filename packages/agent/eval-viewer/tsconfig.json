{
  "extends": "../../tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // bun: co-located `*.test.ts` run under `bun test`, and the agent sources
    // the viewer imports are written against Bun's globals.
    "types": ["vite/client", "node", "bun"]
  },
  "include": ["src", "vite.config.ts"]
}
