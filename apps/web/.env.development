# Dev sessions default to the local relay (`bun run dev` in apps/relay).
# This is the wipe-proof fallback described in sync/relay-url.ts
# defaultRelayUrl(): the localKV override is data and dies with "Delete all
# data", which used to silently re-point a dev install at production. Bun can
# preload this file before Vite selects production mode, so URL consumers must
# gate these overrides on the dev server or a ReadAware Dev bundle identity.
VITE_READAWARE_RELAY_URL=http://localhost:8787

# Links the app opens on the landing site (pricing) go to the local landing
# dev server (`bun run dev:landing`, port from apps/landing/vite.config.ts).
VITE_READAWARE_SITE_URL=http://localhost:5175
