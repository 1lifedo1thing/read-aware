{
  "id": "workspace-profiles",
  "name": "Workspace Profiles",
  "version": "0.11.0",
  "schemaVersion": 1,
  "minAppVersion": "0.3.0",
  "description": "Save the current shelf, appearance and reading setup as a named profile and switch between them.",
  "author": "ReadAware",
  "main": "main.js",
  "permissions": [
    "agent:tools"
  ],
  "settingsAccess": {
    "read": [
      "shelf.layout",
      "shelf.group",
      "shelf.sort",
      "appearance.theme",
      "appearance.motion",
      "reading.fontSize",
      "reading.lineSpacing",
      "reading.fontFamily",
      "appearance.contentTypography.fontFamily",
      "appearance.contentTypography.followReader"
    ],
    "write": [
      "shelf.layout",
      "shelf.group",
      "shelf.sort",
      "appearance.theme",
      "appearance.motion",
      "reading.fontSize",
      "reading.lineSpacing",
      "reading.fontFamily",
      "appearance.contentTypography.fontFamily",
      "appearance.contentTypography.followReader"
    ]
  },
  "requires": {
    "domains": {
      "settings": "^1.8.0"
    },
    "contributions": {
      "headerActions": "^1.0.0",
      "commands": "^1.0.0",
      "agentTools": "^1.2.0"
    },
    "services": {
      "plugins": "^1.3.0",
      "storage": "^2.1.0",
      "transactions": "^1.0.0"
    },
    "schemas": {
      "views": "^1.5.0"
    }
  }
}
