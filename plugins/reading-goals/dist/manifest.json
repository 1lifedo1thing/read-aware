{
  "id": "reading-goals",
  "name": "Reading Goals",
  "version": "0.7.0",
  "schemaVersion": 2,
  "minAppVersion": "0.3.0",
  "description": "Set a reading goal for each book so the assistant knows what you are reading for, with optional long-term memory suggestions.",
  "author": "ReadAware",
  "main": "main.js",
  "permissions": [
    "reading:read",
    "library:read",
    "agent:context",
    "agent:memory",
    "agent:tools"
  ],
  "settingsAccess": {
    "read": [
      "ai.preferences.buildMemory"
    ]
  },
  "requires": {
    "domains": {
      "reading": "^2.24.0",
      "library": "^1.1.0",
      "settings": "^1.2.0"
    },
    "contributions": {
      "headerActions": "^1.0.0",
      "commands": "^1.0.0",
      "agentContextProviders": "^1.1.0",
      "memoryCandidateProviders": "^1.1.0",
      "agentTools": "^1.2.0"
    },
    "services": {
      "storage": "^2.4.0"
    },
    "schemas": {
      "views": "^1.2.0"
    }
  }
}
