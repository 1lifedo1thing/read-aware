{
  "id": "text-desk",
  "name": "Text Desk",
  "version": "0.32.0",
  "schemaVersion": 1,
  "description": "Search book text, browse references and images, control the native image viewer, export images, and manage text preparation.",
  "author": "ReadAware",
  "main": "main.js",
  "permissions": [
    "library:write",
    "reading:write",
    "service:clipboard",
    "service:llm"
  ],
  "requires": {
    "domains": {
      "library": "^1.31.0",
      "reading": "^2.23.0"
    },
    "contributions": {
      "headerActions": "^1.0.0",
      "commands": "^1.0.0",
      "selectionActions": "^1.2.0"
    },
    "services": {
      "session": "^2.10.0",
      "plugins": "^1.8.0",
      "llm": "^1.6.0",
      "ui": "^1.13.0",
      "resources": "^1.2.0",
      "clipboard": "^1.1.0",
      "jobs": "^1.0.0",
      "changes": "^1.0.0",
      "storage": "^2.5.0"
    },
    "schemas": {
      "views": "^1.9.0"
    }
  }
